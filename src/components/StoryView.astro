---
// The body of a story page. Used by the live story pages and by the private draft previews.
import StoryBody from "./StoryBody.astro";
import StoryCard from "./StoryCard.astro";
import { fmtDate, DISCLOSURE } from "../lib.js";
const { g, url, more = [], preview = false } = Astro.props;
---
<div class="wrap">
  {preview && <div class="preview-bar"><strong>{g.draft ? "Draft preview – not live yet." : "Preview – this story is live."}</strong> {g.draft && "Turn on “Publish on the site” in Pages CMS to put it on the site."} <a href={Astro.props.previewHome}>All previews</a></div>}
  <article class="prose gn-story">
    <span class="eyebrow">{fmtDate(g.createdAt)}{g.author && ` · ${g.author}`}</span>
    <h1>{g.title}</h1>
    <p class="gn-dek">{g.excerpt}</p>
    {g.photo && <figure><img class="post-hero" src={g.photo} alt={g.coverAlt || ""}>{g.credit && <figcaption class="note">{g.credit}</figcaption>}</figure>}
    <StoryBody body={g.body} />
    {g.sources && g.sources.length > 0 && <p class="note">Source{g.sources.length > 1 ? "s" : ""}: {g.sources.map((s, i) => <>{i > 0 && " · "}<a href={s.url} target="_blank" rel="noopener">{s.name}</a></>)}</p>}

    {!preview && <div class="gn-share" data-title={g.title}>
      <span>Pass it on:</span>
      <a class="btn small" data-share="facebook" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Share on Facebook</a>
      <button class="btn ghost small" type="button" data-share="copy">Copy link</button>
      <button class="btn ghost small" type="button" data-share="native" hidden>Share…</button>
    </div>}

    <p class="note">{DISCLOSURE}</p>
    <div class="gn-cta">
      <div><h2>Know some good news?</h2><p>A neighbor going the extra mile, a business milestone, a student or team worth cheering for. Tell us and we'll check the details.</p></div>
      <div class="gn-cta-btns"><a class="btn red" href="/share">Share your good news</a></div>
    </div>
  </article>

  {more.length > 0 && <section class="band" style="padding-top:0"><div class="sec-head"><h2>More good news</h2><a href="/">See all →</a></div>
    <div class="gn-grid">{more.map((x) => <StoryCard g={x} />)}</div></section>}
</div>
<style>
  .preview-bar{margin:18px 0 0;padding:12px 16px;border-radius:10px;background:#FFF4D6;border:2px solid #F0B429;color:#3D2E00;font-size:.95rem}
  .preview-bar a{margin-left:8px;font-weight:700}
</style>
