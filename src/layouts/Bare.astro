---
// A stand-alone page with no menu and no links into the rest of the site.
// Used for the pre-launch story form (/tell-us) so people can send stories
// before Good News Rowlett is announced. Hidden from Google.
import "../styles/global.css";
import Logo from "../components/Logo.astro";
const { title = "Good News Rowlett", description = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex, nofollow">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL("/images/good-news-card.png", Astro.site).href}>
  <link rel="icon" type="image/png" href="/good-news-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap">
</head>
<body>
  <header class="gn-strip"><div class="wrap" style="justify-content:center"><Logo small link={false} /></div></header>
  <main id="main"><slot /></main>
  <footer style="padding:28px 20px 40px;text-align:center"><p class="note">Good News Rowlett is a free, locally run community project. Stories are never paid for.</p></footer>
</body>
</html>
