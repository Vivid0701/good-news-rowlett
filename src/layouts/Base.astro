---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { SITE_NAME, DISCLOSURE } from "../lib.js";

const { title, description, image = "/good-news-card.png", jsonLd = null, nav = "", noindex = false, ogType = "website" } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} | Good news from Rowlett, Texas`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/", Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const items = [["/", "Stories", "stories"], ["/about", "About", "about"]];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:title" content={title || SITE_NAME}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/png" href="/good-news-icon.png">
  <link rel="apple-touch-icon" href="/good-news-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="gn-strip">
    <div class="wrap">
      <Logo small />
      <nav class="gn-nav" aria-label="Main">
        {items.map(([href, label, key]) => <a href={href} aria-current={nav === key ? "page" : undefined}>{label}</a>)}
        <a href="/share" class="btn red small">Share good news</a>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site">
    <div class="wrap">
      <div>
        <Logo small />
        <p style="margin-top:12px;opacity:.85;font-size:.95rem;max-width:42ch">Real stories from the neighbors, businesses and moments that make Rowlett, Texas home.</p>
      </div>
      <div><span class="eyebrow" style="color:inherit;opacity:.7">Read</span>
        <ul><li><a href="/">All stories</a></li><li><a href="/about">About Good News Rowlett</a></li></ul></div>
      <div><span class="eyebrow" style="color:inherit;opacity:.7">Take part</span>
        <ul><li><a href="/share">Share good news</a></li><li><a href="/about#guidelines">What we publish</a></li></ul></div>
      <p class="fine">{DISCLOSURE} © {new Date().getFullYear()} Good News Rowlett · Rowlett, TX</p>
    </div>
  </footer>
</body>
</html>
