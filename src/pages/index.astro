---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import StoryCard from "../components/StoryCard.astro";
import { goodNews, fmtDate, DISCLOSURE } from "../lib.js";
const [lead, ...rest] = goodNews;
---
<Base title="" description="Real stories from the neighbors, businesses and moments that make Rowlett, Texas home. Good news worth sharing." nav="stories">
  <section class="gn-hero"><div class="wrap">
    <Logo />
    <p class="gn-intro">Real stories from the neighbors, businesses and moments that make Rowlett home. No politics, no arguments – just the good stuff, ready to share.</p>
    <div class="gn-actions"><a class="btn red" href="/share">Share good news</a></div>
  </div></section>

  <section class="band"><div class="wrap">
    {lead ? <>
      <a class="gn-lead" href={`/${lead.id}`}>
        {lead.cover && <img src={lead.cover} alt={lead.coverAlt || ""} width="1200" height="630">}
        <div class="stack" style="gap:10px">
          <span class="eyebrow">{fmtDate(lead.createdAt)}</span>
          <h2>{lead.title}</h2>
          <p class="muted">{lead.excerpt}</p>
          <span class="gn-more">Read the story →</span>
        </div>
      </a>
      {rest.length > 0 && <div class="gn-grid">{rest.map((g) => <StoryCard g={g} />)}</div>}
    </> : <p class="muted">The first stories are on their way.</p>}
    <p class="note" style="margin-top:28px">{DISCLOSURE}</p>
  </div></section>
</Base>
