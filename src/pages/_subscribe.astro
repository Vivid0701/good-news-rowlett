---
// Email sign-up is turned off for now. To bring it back, rename this file to subscribe.astro
// and re-add the "Get it by email" links (see git history).
import FormPage from "../components/FormPage.astro";
---
<FormPage title="Get it by email" heading="Get the good news by email" name="good-news-email" nav="subscribe" button="Sign me up"
  intro="A short email when there's new good news in Rowlett. No spam, no politics, and you can unsubscribe any time.">
  <div class="two">
    <label>First name <input name="first_name"></label>
    <label>Email <input name="email" type="email" required></label>
  </div>
</FormPage>
