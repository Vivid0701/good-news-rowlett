---
import Base from "../layouts/Base.astro";
import StoryBody from "../components/StoryBody.astro";
import StoryCard from "../components/StoryCard.astro";
import { goodNews, fmtDate, SITE_NAME, DISCLOSURE } from "../lib.js";
export function getStaticPaths() {
  return goodNews.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const url = new URL(`/${g.id}`, Astro.site).href;
const more = goodNews.filter((x) => x.id !== g.id).slice(0, 3);
const image = g.cover || "/good-news-card.png";
const jsonLd = {
  "@context": "https://schema.org", "@type": "NewsArticle", headline: g.title, description: g.excerpt,
  datePublished: g.createdAt ? new Date(g.createdAt).toISOString() : undefined,
  image: new URL(image, Astro.site).href,
  author: { "@type": g.author ? "Person" : "Organization", name: g.author || SITE_NAME },
  publisher: { "@type": "Organization", name: SITE_NAME, logo: { "@type": "ImageObject", url: new URL("/good-news-icon.png", Astro.site).href } },
  mainEntityOfPage: url,
};
---
<Base title={g.title} description={g.excerpt} image={image} jsonLd={jsonLd} ogType="article">
  <div class="wrap">
    <article class="prose gn-story">
      <span class="eyebrow">{fmtDate(g.createdAt)}{g.author && ` · ${g.author}`}</span>
      <h1>{g.title}</h1>
      <p class="gn-dek">{g.excerpt}</p>
      {g.cover && <figure><img class="post-hero" src={g.cover} alt={g.coverAlt || ""} width="1200" height="630">{g.credit && <figcaption class="note">{g.credit}</figcaption>}</figure>}
      <StoryBody body={g.body} />
      {g.sources && g.sources.length > 0 && <p class="note">Source{g.sources.length > 1 ? "s" : ""}: {g.sources.map((s, i) => <>{i > 0 && " · "}<a href={s.url} target="_blank" rel="noopener">{s.name}</a></>)}</p>}

      <div class="gn-share" data-title={g.title}>
        <span>Pass it on:</span>
        <a class="btn small" data-share="facebook" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Share on Facebook</a>
        <button class="btn ghost small" type="button" data-share="copy">Copy link</button>
        <button class="btn ghost small" type="button" data-share="native" hidden>Share…</button>
      </div>

      <p class="note">{DISCLOSURE}</p>
      <div class="gn-cta">
        <div><h2>Know some good news?</h2><p>A neighbor going the extra mile, a business milestone, a student or team worth cheering for. Tell us and we'll check the details.</p></div>
        <div class="gn-cta-btns"><a class="btn red" href="/share">Share your good news</a><a class="btn ghost on-dark" href="/subscribe">Get it by email</a></div>
      </div>
    </article>

    {more.length > 0 && <section class="band" style="padding-top:0"><div class="sec-head"><h2>More good news</h2><a href="/">See all →</a></div>
      <div class="gn-grid">{more.map((x) => <StoryCard g={x} />)}</div></section>}
  </div>
</Base>
<script is:inline>
  (function () {
    var box = document.querySelector(".gn-share"); if (!box) return;
    var here = location.href.split("#")[0].split("?")[0];
    box.querySelector('[data-share="facebook"]').href = "https://www.facebook.com/sharer/sharer.php?u=" + encodeURIComponent(here);
    var copy = box.querySelector('[data-share="copy"]');
    copy.addEventListener("click", function () {
      (navigator.clipboard ? navigator.clipboard.writeText(here) : Promise.reject()).then(function () { copy.textContent = "Link copied"; }, function () { prompt("Copy this link:", here); });
    });
    var nat = box.querySelector('[data-share="native"]');
    if (navigator.share) { nat.hidden = false; nat.addEventListener("click", function () { navigator.share({ title: box.dataset.title, url: here }).catch(function () {}); }); }
  })();
</script>
