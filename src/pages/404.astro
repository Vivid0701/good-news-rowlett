---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="That page isn't here." noindex={true}>
  <div class="wrap"><section class="band" style="max-width:640px"><div class="stack">
    <h1 style="font-size:clamp(2rem,5vw,3rem)">That page isn't here</h1>
    <p class="muted">But there's plenty of good news that is.</p>
    <div><a class="btn red" href="/">See all stories</a></div>
  </div></section></div>
</Base>
