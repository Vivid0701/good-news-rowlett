---
import Base from "../layouts/Base.astro";
---
<Base title="Thank you" description="We got it." noindex={true}>
  <div class="wrap"><section class="band" style="max-width:640px"><div class="stack">
    <h1 style="font-size:clamp(2rem,5vw,3rem)">Thank you!</h1>
    <p id="thanks-msg">We got it.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn red" href="/">Read more good news</a></div>
  </div></section></div>
</Base>
<script is:inline>
  (function () {
    var f = new URLSearchParams(location.search).get("form");
    var m = { "good-news-tip": "Thanks for sharing. We'll check the details and let you know if your story is published." };
    if (m[f]) document.getElementById("thanks-msg").textContent = m[f];
  })();
</script>
