---
import Bare from "../layouts/Bare.astro";
---
<Bare title="Thank you | Good News Rowlett">
  <div class="wrap"><section class="band" style="max-width:640px;margin:0 auto;text-align:center"><div class="stack" style="align-items:center">
    <h1 style="font-size:clamp(2rem,5vw,3rem)">Thank you!</h1>
    <p>Your good news is on its way to us. We'll check the details and reach out if we have any questions.</p>
    <p class="muted">Know someone else with a story? Send them this same link.</p>
  </div></section></div>
</Bare>
