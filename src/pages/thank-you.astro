---
// Shown after someone sends a story from /share or /tell-us. No menu or links.
import Bare from "../layouts/Bare.astro";
---
<Bare title="Thank you | Good News Rowlett">
  <div class="wrap">
    <section class="band" style="max-width:620px;margin:0 auto;text-align:center">
      <div class="stack" style="align-items:center;gap:18px">
        <svg viewBox="0 0 200 96" aria-hidden="true" style="width:120px;display:block;margin:0 auto">
          <g stroke="#ED1C24" stroke-width="7" stroke-linecap="round">
            <line x1="156.4" y1="67.5" x2="175.2" y2="60.6" /><line x1="146" y1="49.4" x2="161.3" y2="36.6" />
            <line x1="130" y1="36" x2="140" y2="18.7" /><line x1="110.4" y1="28.9" x2="113.9" y2="9.2" />
            <line x1="89.6" y1="28.9" x2="86.1" y2="9.2" /><line x1="70" y1="36" x2="60" y2="18.7" />
            <line x1="54" y1="49.4" x2="38.7" y2="36.6" /><line x1="43.6" y1="67.5" x2="24.8" y2="60.6" />
          </g>
          <path d="M58 88 A42 42 0 0 1 142 88 Z" fill="#ED1C24" />
          <rect x="0" y="88" width="200" height="7" rx="3.5" fill="#0B0B0B" />
        </svg>
        <h1 style="font-size:clamp(2rem,5vw,3rem)">Thank you for sharing!</h1>
        <p style="font-size:1.15rem">We're so glad you took the time to tell us about the good happening in Rowlett.</p>
        <p>We'll read every word, check a few details, and reach out by email to let you know if and when your story will be published. If we have any questions, we'll be in touch.</p>
        <p class="muted">Know someone else with good news to share? Send them the same link you used.</p>
      </div>
    </section>
  </div>
</Bare>
